# Grihine Soap — Hostinger FTP credentials
# Copy this file:   cp .deploy.env.example .deploy.env
# Then fill in the three values below from Hostinger hPanel:
#   hPanel → your hosting plan → Manage → Files → FTP Accounts
# (.deploy.env is gitignored — your password never gets committed)

HOSTINGER_FTP_HOST=REPLACE_ME        # "FTP IP" or "FTP hostname", e.g. 145.79.x.x or ftp.grihinesoap.com
HOSTINGER_FTP_USER=REPLACE_ME        # "FTP username", e.g. u123456789.grihinesoap.com
HOSTINGER_FTP_PASS=REPLACE_ME        # the FTP password (reset it on the same page if unknown)

# Optional — only change if your FTP account doesn't land at the domain root:
HOSTINGER_REMOTE_DIR=public_html
